<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Full regression: auth and navigation UI plus the API services. The Fast
  Track end-to-end test creates real data and makes a real payment on stage, so it has its own suite
  (testng-fast-track.xml, mvn test -P fast-track). See FRAMEWORK.md.
  Run: mvn test   (regression is the default profile)
-->
<!--
  TestListener + AllureTestNg are NOT declared here — see BaseTest's
  Javadoc: TestListener is registered once via @Listeners on BaseTest, and
  AllureTestNg auto-registers itself via TestNG's ServiceLoader. Declaring
  either again here would double-register it and corrupt Allure's report
  (confirmed live: orphaned/missing failure screenshots).
-->
<suite name="Mosadad — Full Regression" verbose="1" parallel="none" thread-count="1">

    <test name="Auth — UI">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.mosadad.testing.tests.auth.LoginUiTest"/>
            <class name="com.mosadad.testing.tests.auth.ForgotPasswordUiTest"/>
            <class name="com.mosadad.testing.tests.auth.LoginLanguageUiTest"/>
        </classes>
    </test>

    <test name="Entity Navigation — UI">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.mosadad.testing.tests.navigation.RecoveryClaimsNavigationTest"/>
        </classes>
    </test>

    <test name="Auth API">
        <classes>
            <class name="com.mosadad.testing.tests.api.AuthApiTest"/>
        </classes>
    </test>

    <test name="Tenant API">
        <packages>
            <package name="com.mosadad.testing.tests.api.tenant"/>
        </packages>
    </test>

    <test name="IntHub API">
        <packages>
            <package name="com.mosadad.testing.tests.api.inthub"/>
        </packages>
    </test>

    <test name="Quotation API">
        <packages>
            <package name="com.mosadad.testing.tests.api.quotation"/>
        </packages>
    </test>

    <test name="Settlement API">
        <packages>
            <package name="com.mosadad.testing.tests.api.settlement"/>
        </packages>
    </test>

    <test name="Invoice API">
        <packages>
            <package name="com.mosadad.testing.tests.api.invoice"/>
        </packages>
    </test>

    <test name="Claims API">
        <packages>
            <package name="com.mosadad.testing.tests.api.claims"/>
        </packages>
    </test>

</suite>
