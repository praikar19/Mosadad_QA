<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  UI-only suite — real, verified tests (Login + Entity Navigation).
  Run: mvn test -P ui
-->
<!--
  TestListener + AllureTestNg are NOT declared here — see BaseTest's
  Javadoc: TestListener is registered once via @Listeners on BaseTest, and
  AllureTestNg auto-registers itself via TestNG's ServiceLoader. Declaring
  either again here would double-register it and corrupt Allure's report
  (confirmed live: orphaned/missing failure screenshots).
-->
<suite name="Mosadad — UI Tests" verbose="1" parallel="tests" thread-count="2">

    <test name="Auth — UI">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.mosadad.testing.tests.auth.LoginUiTest"/>
            <class name="com.mosadad.testing.tests.auth.ForgotPasswordUiTest"/>
            <class name="com.mosadad.testing.tests.auth.LoginLanguageUiTest"/>
        </classes>
    </test>

    <test name="Entity Navigation — UI">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.mosadad.testing.tests.navigation.RecoveryClaimsNavigationTest"/>
        </classes>
    </test>

</suite>
