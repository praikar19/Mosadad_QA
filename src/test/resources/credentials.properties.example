# Copy this file to credentials.properties (same directory) and fill in real
# values. credentials.properties is gitignored — never commit real secrets.
#
# Every key can also be injected at runtime without touching any file:
#   mvn test -P smoke -Dqa.claimant.email=... -Dqa.claimant.password=...
# which is the preferred approach for CI.

qa.claimant.email=
qa.claimant.password=
